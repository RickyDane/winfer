{
  "id": "example-hello",
  "name": "Example: hello",
  "version": "1.0.0",
  "description": "Shows every kind of contribution: an agent CLI, a recipe, a declarative tool and code.",
  "author": "winfer",
  "main": "index.js",
  "providers": [
    {
      "id": "gemini",
      "name": "Gemini CLI",
      "command": "gemini",
      "resumeArgs": ["--resume", "latest"],
      "aliases": ["gemini", "jim and i"],
      "promptFlag": "--prompt-interactive",
      "modelArg": "--model"
    }
  ],
  "recipes": [
    { "id": "review", "name": "Agent + tests", "panes": [{ "provider": "claude" }, { "provider": "shell", "prompt": "pnpm test --watch" }], "preset": "columns" }
  ],
  "tools": [
    {
      "id": "run_script",
      "title": "Run package script",
      "description": "Run an npm script like test, lint or build in a new shell pane",
      "params": {
        "script": { "kind": "enum", "ask": "Which script should run?", "options": { "test": "Tests", "lint": "Linter", "build": "Build" } }
      },
      "commands": [{ "type": "pane.spawn", "provider": "shell", "prompt": "pnpm {{script}}" }],
      "palette": [
        { "title": "Run tests", "args": { "script": "test" } },
        { "title": "Run lint", "args": { "script": "lint" } }
      ]
    }
  ]
}
