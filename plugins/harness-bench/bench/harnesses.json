{
  "_comment": "argv: {prompt}, {model} and {winfer} are replaced. model: default; models: suggestions shown in the UI. parser reads the JSON output: winfer, claude, codex, pi or none. effort (optional): how to pass a reasoning/thinking effort, either argv (inserted before {prompt}, with {effort} replaced) or model (a template for {model}, e.g. {model}#{effort}), and levels: the choices shown in the UI. requires (optional): other CLIs the harness runs (winfer code drives the claude and codex CLIs); without them it counts as not installed and the app hides it. Compare harnesses on the same model.",
  "_pricing": {
    "checked": "2026-10-17",
    "units": "USD per 1M tokens, standard short-context API rates",
    "sources": [
      "https://developers.openai.com/api/docs/pricing",
      "https://developers.openai.com/api/docs/models/gpt-6-sol",
      "https://platform.claude.com/docs/en/about-claude/pricing"
    ],
    "note": "Estimates exclude tool fees, cache-write premiums, long-context, speed and regional surcharges. Claude CLI aliases use reported costs; their model versions are not guessed."
  },
  "_prices": {
    "gpt-6.1-sol": { "input": 2, "cached": 0.1, "output": 10 },
    "gpt-6-astra": { "input": 10, "cached": 1, "output": 50 },
    "gpt-6-sol": { "input": 2, "cached": 0.2, "output": 10 },
    "gpt-6-luna": { "input": 0.1, "cached": 0.01, "output": 0.5 },
    "claude-fable-5-1": { "input": 10, "cached": 0.25, "output": 50 },
    "claude-opus-5-5": { "input": 4, "cached": 0.2, "output": 20 },
    "claude-sonnet-5-5": { "input": 2, "cached": 0.1, "output": 10 },
    "claude-haiku-5-5": { "input": 0.1, "cached": 0.01, "output": 0.5 }
  },
  "winfer-chatgpt": {
    "label": "winfer code \u00b7 ChatGPT",
    "argv": [
      "{winfer}",
      "code",
      "-p",
      "--json",
      "--mode",
      "yolo",
      "-m",
      "chatgpt/{model}",
      "{prompt}"
    ],
    "model": "gpt-6.1-sol",
    "models": [
      "gpt-6.1-sol",
      "gpt-6-astra",
      "gpt-6-sol",
      "gpt-6-luna"
    ],
    "effort": {
      "argv": [
        "--effort",
        "{effort}"
      ],
      "levels": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "parser": "winfer"
  },
  "winfer-claude": {
    "label": "winfer code \u00b7 Claude",
    "argv": [
      "{winfer}",
      "code",
      "-p",
      "--json",
      "--mode",
      "yolo",
      "-m",
      "claude/{model}",
      "{prompt}"
    ],
    "model": "sonnet",
    "models": [
      "fable",
      "opus",
      "sonnet",
      "haiku"
    ],
    "effort": {
      "argv": [
        "--effort",
        "{effort}"
      ],
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "parser": "winfer",
    "requires": ["claude"]
  },
  "winfer-codex": {
    "label": "winfer code \u00b7 Codex",
    "argv": [
      "{winfer}",
      "code",
      "-p",
      "--json",
      "--mode",
      "yolo",
      "-m",
      "codex/{model}",
      "{prompt}"
    ],
    "model": "gpt-6.1-sol",
    "models": [
      "gpt-6.1-sol",
      "gpt-6.1-sol-fast",
      "gpt-6-astra",
      "gpt-6-sol",
      "gpt-6-luna"
    ],
    "effort": {
      "argv": [
        "--effort",
        "{effort}"
      ],
      "levels": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "parser": "winfer",
    "requires": ["codex"]
  },
  "codex": {
    "label": "Codex",
    "argv": [
      "codex",
      "exec",
      "--json",
      "--skip-git-repo-check",
      "--dangerously-bypass-approvals-and-sandbox",
      "-m",
      "{model}",
      "{prompt}"
    ],
    "model": "gpt-6.1-sol",
    "models": [
      "gpt-6.1-sol",
      "gpt-6-astra",
      "gpt-6-sol",
      "gpt-6-luna"
    ],
    "effort": {
      "argv": [
        "-c",
        "model_reasoning_effort={effort}"
      ],
      "levels": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "parser": "codex"
  },
  "claude": {
    "label": "Claude Code",
    "argv": [
      "claude",
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--dangerously-skip-permissions",
      "--model",
      "{model}",
      "{prompt}"
    ],
    "model": "sonnet",
    "models": [
      "fable",
      "opus",
      "sonnet",
      "haiku"
    ],
    "effort": {
      "argv": [
        "--effort",
        "{effort}"
      ],
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "parser": "claude"
  },
  "pi": {
    "label": "pi",
    "argv": [
      "pi",
      "-p",
      "--mode",
      "json",
      "--model",
      "{model}",
      "{prompt}"
    ],
    "model": "openai/gpt-6.1-sol",
    "models": [
      "openai/gpt-6.1-sol",
      "openai/gpt-6-luna",
      "anthropic/claude-sonnet-5-5"
    ],
    "effort": {
      "argv": [
        "--thinking",
        "{effort}"
      ],
      "levels": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "parser": "pi"
  },
  "opencode": {
    "label": "OpenCode",
    "argv": [
      "opencode",
      "run",
      "--standalone",
      "--format",
      "json",
      "-m",
      "{model}",
      "{prompt}"
    ],
    "model": "openai/gpt-6.1-sol",
    "models": [
      "openai/gpt-6.1-sol",
      "openai/gpt-6.1-sol-fast"
    ],
    "effort": {
      "model": "{model}#{effort}",
      "levels": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "parser": "opencode"
  },
  "oracle": {
    "label": "Reference solutions",
    "argv": [],
    "parser": "oracle"
  },
  "noop": {
    "label": "No-op (checks must fail)",
    "argv": [
      "true"
    ],
    "parser": "none"
  }
}
